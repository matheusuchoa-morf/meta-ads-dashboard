# ─────────────────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha com SEUS valores.
# NUNCA comite o .env.local (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Acesso ao dashboard (senha simples via cookie) ──
DASHBOARD_PASSWORD=troque-esta-senha
NEXT_PUBLIC_BRAND_NAME=      # nome exibido no topo/login (ex: ACME). Vazio = "ADS DASHBOARD"
NEXTAUTH_URL=http://localhost:3000

# ── Meta / Facebook Ads ──
META_ACCESS_TOKEN=            # token de acesso da sua app Meta (Marketing API)
META_AD_ACCOUNT_ID=           # ex: act_1234567890 (sua conta de anúncios)
META_IG_USER_ID=             # id do usuário do Instagram (opcional)
META_PIXEL_ID=               # id do pixel (opcional, p/ CAPI)

# ── Hotmart (vendas) ──
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_HOTTOK=              # token do webhook (opcional)

# ── Microsoft Clarity (saúde do funil) ──
CLARITY_API_TOKEN=

# ── Métricas / meta de negócio ──
NEXT_PUBLIC_GOAL_CURRENT=100   # meta de vendas da edição atual
NEXT_PUBLIC_GOAL_LEGACY=100    # meta histórica (travada)
NEXT_PUBLIC_GOAL_CUTOFF=2025-01-01  # data da 1a venda da edição atual
AVG_TICKET=47               # ticket médio p/ estimativas
DEMO_MODE=false            # true = usa dados fake, não chama APIs

# ── Notificações (todas opcionais) ──
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# ── Cron self-ping (GitHub Actions) ──
CRON_SECRET=                # mesmo valor guardado em Settings > Secrets > CRON_SECRET

# ── ActiveCampaign (leads, opcional) ──
ACTIVECAMPAIGN_ACCOUNT=
ACTIVECAMPAIGN_API_KEY=

# ── YouTube (opcional) ──
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# obs: o fluxo OAuth do YouTube usa um client_secret.json na raiz.
# NUNCA comite esse arquivo — ele está no .gitignore.
